# AGAPORA AI + image assistants (post-computation only)
# Text interpretation default: Groq free tier (OpenAI-compatible)
AGAPORA_AI_ENABLED=false
AGAPORA_AI_AUTO=true
AGAPORA_AI_VISUAL_DESCRIPTION_ENABLED=true
AGAPORA_AI_PROVIDER=groq
AGAPORA_AI_BASE_URL=https://api.groq.com/openai/v1
AGAPORA_AI_MODEL=llama-3.3-70b-versatile
AGAPORA_AI_API_KEY=
GROQ_API_KEY=

# -------------------------------------------------------------------------
# OpenRouter Image Generation (primary)
# Token MUST stay in backend/.env only — never put it in React / Vite env.
# Create a key: https://openrouter.ai/keys
# When credits run out, AGAPORA switches to Hugging Face automatically.
# -------------------------------------------------------------------------
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image
OPENROUTER_IMAGE_ASPECT_RATIO=4:3
OPENROUTER_IMAGE_TIMEOUT=180
OPENROUTER_EXHAUSTED_TTL=21600

# -------------------------------------------------------------------------
# Hugging Face Image Generation (fallback when OpenRouter is out of tokens)
# Token MUST stay in backend/.env only — never put it in React / Vite env.
# Create a NEW token: https://huggingface.co/settings/tokens
# Permission: Inference Providers
# -------------------------------------------------------------------------
HF_TOKEN=YOUR_NEW_HUGGING_FACE_TOKEN
HF_IMAGE_MODEL=krea/Krea-2-Turbo
HF_IMAGE_PROVIDER=fal-ai
HF_IMAGE_TIMEOUT=180

# Alternative model (gated — accept the license on huggingface.co first):
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
# HF_IMAGE_PROVIDER=auto

OFFSPRING_IMAGE_ENABLED=true
OFFSPRING_IMAGE_AUTO=false
OFFSPRING_IMAGE_PROVIDER=openrouter
OFFSPRING_IMAGE_FALLBACK_PROVIDER=huggingface

# After editing .env:
#   php artisan config:clear
#   php artisan storage:link
#   php artisan migrate
